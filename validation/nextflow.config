plugins {
    id 'nf-amazon@3.9.1'
    id 'nf-tiered-awsbatch@0.3.0'
}

process {
    executor = 'tiered-awsbatch-validation'
    container = 'ubuntu:24.04'
    queue = 'fixture-spot'
    errorStrategy = 'retry'
    maxRetries = 20
    maxErrors = -1
}

tieredAwsBatch {
    enabled = true
    reporting = true
    interruptionThreshold = 3
    ordinaryRetryAllowance = 2
    queueMappings = ['fixture-spot': 'fixture-demand']
}

aws {
    region = 'us-east-1'
    accessKey = 'fixture'
    secretKey = 'fixture'
}

executor {
    pollInterval = '50 ms'
    queueSize = 10
}

trace {
    enabled = true
    file = 'trace.txt'
    fields = 'task_id,process,status,exit,native_id,queue'
    overwrite = true
}
